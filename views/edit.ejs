<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>Document</title>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-white ">
       
        <form action="/edit" method="post">
                <input class="block px-5 py-2 bg-zinc-800 w-1/4 rounded-md outline-none text-zinc-500" type="text" placeholder="Previous title" name="previous" value="<%= filename%>">

                <input class="block px-5 py-2 bg-zinc-800 w-1/4 rounded-md outline-none mt-3" type="text" placeholder="New title" name="new" >

                <input class="mt-2 bg-red-600 rounded-md px-5 py-2 active:scale-95 " type="submit" value="update changes">
            </form>

       <a class="text-blue-500 inline-block mt-10 " href="/">go back ></a>
    </div> 
</body>
</html>